# Server-only Laravel origin. Use the local API for npm run dev.
API_UPSTREAM_URL=http://localhost:8000
# Must exactly match Laravel's SESSION_COOKIE.
LARAVEL_SESSION_COOKIE=laravel_session

# Production (Vercel server environment):
# API_UPSTREAM_URL=https://volymoly.com
# LARAVEL_SESSION_COOKIE=laravel_session
# Google credentials belong exclusively in backend-api, never NEXT_PUBLIC_*.

# Private server-only key matching Laravel AUTH_PROXY_SECRET; never NEXT_PUBLIC_.
AUTH_PROXY_SECRET=
